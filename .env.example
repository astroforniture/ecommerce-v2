# Supabase (pubblico / anon)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe — PRODUZIONE (LIVE)
# Frontend (Vercel / .env.local): solo Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Alias opzionale accettato dal build Vite:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Backend (Supabase Edge Function secrets — NON nel frontend):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_REQUIRE_LIVE=true
# STRIPE_TEST_MODE=false
